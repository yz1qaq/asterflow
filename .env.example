# Copy to .env and replace this development-only password.
# .env is ignored by Git. Keep password values consistent in the two URLs.
ASTERFLOW_POSTGRES_PASSWORD=replace_with_local_password
ASTERFLOW_POSTGRES_PORT=25432
ASTERFLOW_DATABASE_URL='postgres://asterflow:replace_with_local_password@127.0.0.1:25432/asterflow?sslmode=disable'
# Pool tests are read-only; migration tests create and clean isolated schemas.
ASTERFLOW_TEST_DATABASE_URL='postgres://asterflow:replace_with_local_password@127.0.0.1:25432/asterflow?sslmode=disable'

# Required: generate a random secret with at least 32 bytes.
ASTERFLOW_JWT_SECRET_KEY=
# Bootstrap is opt-in; provide credentials explicitly when enabled.
ASTERFLOW_AUTOSEED_ADMIN=false
ASTERFLOW_AUTOSEED_ADMIN_EMAIL=admin@example.com
ASTERFLOW_AUTOSEED_ADMIN_PASSWORD=

# Credential encryption master key: generate independently, persist across restarts.
# Required: at least 32 bytes. Do not reuse JWT key or commit the real value.
ASTERFLOW_CREDENTIAL_SECRET_KEY=
